generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Table {
  id               Int               @id @default(autoincrement())
  number           Int
  zone             String            @default("outside")
  seats            Int?              @default(4)
  name             String?
  ticketPrintedAt  DateTime?
  orders           Order[]
  preOrderSessions PreOrderSession[]

  @@unique([number, zone])
}

model Order {
  id         String      @id @default(cuid())
  tableId    Int
  table      Table       @relation(fields: [tableId], references: [id])
  status     String      @default("open")
  totalCents Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
  payments   Payment[]

  @@index([tableId, status])
}

model OrderItem {
  id              Int       @id @default(autoincrement())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])
  menuItemId      Int?
  menuItem        MenuItem? @relation(fields: [menuItemId], references: [id])
  name            String
  primaryName     String?
  secondaryName   String?
  qty             Int
  unitPriceCents  Int       @default(0)
  totalPriceCents Int       @default(0)

  @@index([orderId])
  @@index([menuItemId])
}

model MenuItem {
  id            Int            @id @default(autoincrement())
  name          String
  primaryName   String?
  secondaryName String?
  priceCents    Int
  costCents     Int?
  sku           String?        @unique
  category      String         @default("Uncategorized")
  description   String?
  imageDataUrl  String?
  available     Boolean        @default(true)
  orderItems    OrderItem[]
  preOrderItems PreOrderItem[]

}

model Payment {
  id          Int      @id @default(autoincrement())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  amountCents Int
  method      String?
  createdAt   DateTime @default(now())

  @@index([orderId])
}

model PaidTicket {
  id                     String           @id @default(cuid())
  ticketNumber           String           @unique
  idempotencyKey         String?          @unique
  idempotencyFingerprint String?
  mode                   String
  method                 String
  tableNumber            Int
  tableZone              String
  totalCents             Int
  taxableBaseCents       Int
  vatCents               Int
  vatRatePercent         Int
  splitPeople            Int?
  businessName           String           @default("")
  tradeName              String           @default("")
  businessTaxId          String           @default("")
  businessAddress        String?
  businessCity           String?
  businessPhone          String?
  terminalId             String?
  cashierName            String?
  customerName           String?
  customerTaxId          String?
  status                 String           @default("paid")
  relatedTicketNumber    String?
  pdfFileReference       String?
  auditMetadata          String?
  createdAt              DateTime         @default(now())
  items                  PaidTicketItem[]

  @@index([tableZone, tableNumber])
  @@index([createdAt])
  @@index([status])
}

model PaidTicketItem {
  id              Int        @id @default(autoincrement())
  ticketId        String
  ticket          PaidTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderId         String?
  orderItemId     Int?
  menuItemId      Int?
  name            String
  primaryName     String?
  secondaryName   String?
  qty             Int
  unitPriceCents  Int
  totalPriceCents Int

  @@index([ticketId])
}

model PreOrderSession {
  id        String         @id @default(cuid())
  tableId   Int
  table     Table          @relation(fields: [tableId], references: [id])
  status    String         @default("draft")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  items     PreOrderItem[]

  @@index([tableId, status])
}

model PreOrderItem {
  id              Int             @id @default(autoincrement())
  sessionId       String
  session         PreOrderSession @relation(fields: [sessionId], references: [id])
  menuItemId      Int?
  menuItem        MenuItem?       @relation(fields: [menuItemId], references: [id])
  name            String
  primaryName     String?
  secondaryName   String?
  qty             Int
  unitPriceCents  Int             @default(0)
  totalPriceCents Int             @default(0)

  @@index([sessionId])
  @@index([menuItemId])
}

model TicketSequence {
  series    String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model MutationReceipt {
  idempotencyKey String   @id
  fingerprint    String
  operation      String
  tableNumber    Int
  tableZone      String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
