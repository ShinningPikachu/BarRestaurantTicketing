{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node ../../scripts/expo-start.mjs default",
    "dev:phone": "node ../../scripts/expo-start.mjs phone --lan",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:apk": "bash ../../scripts/build-android-apk.sh",
    "ios": "expo run:ios",
    "web": "node ../../scripts/expo-start.mjs default --web",
    "web:desktop": "node ../../scripts/expo-start.mjs desktop --web",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.4",
    "expo-camera": "~56.0.7",
    "expo-image-manipulator": "~56.0.14",
    "expo-image-picker": "~56.0.13",
    "expo-print": "~56.0.3",
    "expo-sharing": "~56.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-web": "^0.21.0",
    "toqr": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.14",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
