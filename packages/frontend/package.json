{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "dev:phone": "expo start --lan",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:apk": "node ../../scripts/build-android-apk.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:desktop": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0",
    "shared": "*"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
