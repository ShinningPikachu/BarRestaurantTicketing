# Local development ports
PORT=3000
DESKTOP_EXPO_PORT=8081
PHONE_EXPO_PORT=8082

# POS_ACCESS_CODE and POS_AUTH_TOKEN are generated into the private .env file
# when missing. Set strong custom values here only in a private local .env.
# POS_ACCESS_CODE=ChangeThisCode
# POS_AUTH_TOKEN=ReplaceWithAtLeast32RandomCharacters

# Optional additional trusted web origins. The combined launcher automatically
# derives localhost origins from DESKTOP_EXPO_PORT.
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Ticket business details
EXPO_PUBLIC_TICKET_TRADE_NAME="YOUR BAR NAME"
EXPO_PUBLIC_TICKET_BUSINESS_NAME="YOUR LEGAL BUSINESS NAME"
EXPO_PUBLIC_TICKET_BUSINESS_NIF="YOUR TAX ID"
EXPO_PUBLIC_TICKET_BUSINESS_ADDRESS="YOUR BUSINESS ADDRESS"
EXPO_PUBLIC_TICKET_BUSINESS_CITY="YOUR CITY"
EXPO_PUBLIC_TICKET_BUSINESS_PHONE="YOUR PHONE"
EXPO_PUBLIC_TICKET_VAT_RATE=10

# XP-Q200 / POS-80 printer configured as a raw CUPS/system queue
XPRINTER_PRINTER_NAME=POS80_RAW
XPRINTER_SYSTEM_PRINTER_RAW=true
EXPO_PUBLIC_TICKET_PRINT_MODE=xprinter-usb

# Set XPRINTER_SYSTEM_PRINTER_RAW=false only for a normal CUPS driver queue.
# Cash-drawer commands require raw mode when using XPRINTER_PRINTER_NAME.

# Optional direct USB device instead of a system queue:
# XPRINTER_USB_DEVICE=/dev/usb/lp0

# Optional LAN printer mode instead of USB:
# XPRINTER_HOST=192.168.1.50
# XPRINTER_PORT=9100
# EXPO_PUBLIC_TICKET_PRINT_MODE=xprinter-lan
